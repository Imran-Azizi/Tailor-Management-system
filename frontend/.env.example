# Same-origin subdomain deployment (tenant1.example.com -> tenant1.example.com/api):
VITE_API_URL=/api
VITE_ROOT_DOMAIN=hoshmandsafi.com
VITE_ADMIN_SUBDOMAIN=admin

# Split deployment (frontend and API on different hosts):
# VITE_API_URL=https://api.your-domain.com/api

# Local dev only — Vite proxy target for `npm run dev`
VITE_PROXY_TARGET=http://localhost:8000
