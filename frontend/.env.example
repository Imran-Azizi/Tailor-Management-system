# VPS deployment (hoshmandsafi.com):
VITE_API_URL=http://hoshmandsafi.com/api

# Same-origin deployment (nginx proxies /api to backend):
# VITE_API_URL=/api

# Split deployment (frontend and API on different hosts):
# VITE_API_URL=https://api.your-domain.com/api

# Local dev only — Vite proxy target for `npm run dev`
VITE_PROXY_TARGET=http://localhost:8000
