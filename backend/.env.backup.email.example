# Backup and restore configuration (email-only template)
# Copy required values into backend/.env and replace placeholders.

BACKUP_ENABLED=true
BACKUP_CRON="0 2 * * *"
BACKUP_TIMEZONE="Asia/Kabul"

# Source DB for pg_dump. If omitted, DATABASE_URL is used.
BACKUP_DATABASE_URL="postgresql://postgres:REPLACE_ME@localhost:5432/tailor_management_system"

# Restore test target DB (must never be the same as BACKUP_DATABASE_URL)
STAGING_DATABASE_URL="postgresql://postgres:REPLACE_ME@localhost:5432/tailor_staging"

# Encryption key used for AES-256-GCM (use a strong secret)
BACKUP_ENCRYPTION_KEY=replace-with-strong-random-key

# Optional health endpoint used by restore tests
BACKUP_HEALTHCHECK_URL="http://localhost:8000/api/health"

# Retention policy
BACKUP_RETENTION_DAILY_DAYS=35
BACKUP_RETENTION_WEEKLY_DAYS=90
BACKUP_RETENTION_MONTHLY_DAYS=365

# Email provider mode
BACKUP_STORAGE_PROVIDER=email

# Recipients
BACKUP_EMAIL_TO=ops@example.com
BACKUP_EMAIL_CC=
BACKUP_EMAIL_BCC=
BACKUP_EMAIL_FROM=
BACKUP_EMAIL_SUBJECT_PREFIX=Tailor Backup

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password

# Keep local encrypted archive for restore tests and download API
BACKUP_EMAIL_ARCHIVE_ENABLED=true
