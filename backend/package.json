{
  "name": "tailor-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "fonts:ensure": "node src/scripts/ensureReportFonts.js",
    "prisma:generate": "prisma generate",
    "start": "npm run start:prod",
    "start:prod": "node src/scripts/ensureReportFonts.js && prisma generate && prisma migrate deploy && node src/index.js",
    "start:dev": "node src/scripts/ensureReportFonts.js && prisma generate && prisma migrate deploy && node prisma/seed.js && node src/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db push --accept-data-loss && node prisma/seed.js",
    "db:studio": "prisma studio",
    "backup:run": "node src/scripts/runBackup.js",
    "backup:test-restore": "node src/scripts/runRestoreTest.js",
    "backup:gdrive-oauth": "node src/scripts/gdriveOauthToken.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "prisma": "^6.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
