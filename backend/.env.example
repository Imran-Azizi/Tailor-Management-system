DATABASE_URL="postgresql://user:password@localhost:5432/tailor_db"
PORT=5000
FRONTEND_URL=http://localhost:5173

# JWT — generate strong random secrets before deploying to production
JWT_SECRET="tailor-secret-key-change-in-prod"
JWT_REFRESH_SECRET="tailor-refresh-secret-change-in-prod"

# ─── SMS Notifications (Twilio) ───────────────────────────────────────────────
# Set SMS_ENABLED=true to activate real SMS sending via Twilio.
# When false (default), messages are logged to console only (safe for dev/staging).
# SMS_ENABLED=true

# Twilio credentials — get from https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890   # Your Twilio phone number in E.164 format

# Tailor shop name shown in SMS messages sent to customers
# SHOP_NAME="Hoshmand Safi Tailoring"

# ─── Backup & Disaster Recovery ───────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_CRON="0 2 * * *"
BACKUP_TIMEZONE="Asia/Kabul"

# Source DB for pg_dump. Falls back to DATABASE_URL when empty.
BACKUP_DATABASE_URL="postgresql://user:password@localhost:5432/tailor_db"

# Mandatory test/staging DB for restore test jobs (never production).
STAGING_DATABASE_URL="postgresql://user:password@localhost:5432/tailor_staging"

# S3 compatible provider options: s3, r2, or gdrive
BACKUP_STORAGE_PROVIDER=s3
BACKUP_BUCKET_NAME=tailor-backups
BACKUP_REGION=auto
BACKUP_ACCESS_KEY_ID=replace-me
BACKUP_SECRET_ACCESS_KEY=replace-me

# Required for Cloudflare R2 and optional for custom S3 endpoints
BACKUP_ENDPOINT=

# ─── Google Drive (set BACKUP_STORAGE_PROVIDER=gdrive to use instead of S3) ──
# BACKUP_GDRIVE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# BACKUP_GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# BACKUP_GDRIVE_FOLDER_ID=your-google-drive-folder-id

# 32-byte key (base64/hex/plain text). Keep secret.
BACKUP_ENCRYPTION_KEY=replace-with-strong-random-key

# Optional health endpoint used during restore tests
BACKUP_HEALTHCHECK_URL="http://localhost:8000/api/health"

BACKUP_RETENTION_DAILY_DAYS=35
BACKUP_RETENTION_WEEKLY_DAYS=90
BACKUP_RETENTION_MONTHLY_DAYS=365
