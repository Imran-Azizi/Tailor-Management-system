DATABASE_URL="postgresql://user:password@localhost:5432/tailor_db"
PORT=5000
FRONTEND_URL=http://localhost:5173

# JWT — generate strong random secrets before deploying to production
JWT_SECRET="tailor-secret-key-change-in-prod"
JWT_REFRESH_SECRET="tailor-refresh-secret-change-in-prod"

# ─── SMS Notifications (Twilio) ───────────────────────────────────────────────
# Set SMS_ENABLED=true to activate real SMS sending via Twilio.
# When false (default), messages are logged to console only (safe for dev/staging).
# SMS_ENABLED=true

# Twilio credentials — get from https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890   # Your Twilio phone number in E.164 format

# Tailor shop name shown in SMS messages sent to customers
# SHOP_NAME="Khan Rahimi Tailoring"