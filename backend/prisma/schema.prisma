  @@index([orderId])
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id                    String                 @id @default(uuid())
  tenantId              String                 @default("default-tenant")
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountType           AccountType
  userId                String
  user                  User                   @relation("UserTransactions", fields: [userId], references: [id])
  orderId               String?
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                  TransactionKind        @default(LOAN)
  source                TransactionSource      @default(MANUAL)
  amount                Float
  transactionDate       DateTime
  note                  String?
  createdById           String
  createdBy             User                   @relation("CreatedTransactions", fields: [createdById], references: [id])
  damagedClothesPenalty DamagedClothesPenalty?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, transactionDate])
  @@index([orderId])
  @@index([accountType])
  @@index([kind])
  @@index([source])
  @@index([createdById])
  @@index([userId, source, kind])
  @@index([transactionDate])
  @@index([source, kind, transactionDate])
  @@index([createdById, transactionDate])
}

model DamagedClothesPenalty {
  id                 String      @id @default(uuid())
  tenantId           String      @default("default-tenant")
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId      String      @unique
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation("DamagedPenaltyUser", fields: [userId], references: [id], onDelete: Restrict)
  orderId            String
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roleType           AccountType
  reason             String
  confirmedDuplicate Boolean     @default(false)
  workerPaymentStatus String?

  billNumber   Int
  customerName String
  orderType    OrderType

  totalOrderAmount Float
  rakhtExpense     Float
  dokhtExpense     Float
  qichikarExpense  Float
  dailyTaskExpense Float
  totalExpense     Float

  createdById String
  createdBy   User     @relation("DamagedPenaltyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([orderId])
  @@index([createdById])
  @@index([roleType])
  @@index([createdAt])
  @@unique([orderId])
}

enum ItemType {
  WATCH
  PERFUME
  BOOT
  RING
  SLIPPER
}

model Item {
  id            String     @id @default(uuid())
  tenantId      String     @default("default-tenant")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          ItemType
  name          String
  brand         String
  code          String
  quantity      Int        @default(0)
  originalPrice Float
  notes         String?
  sales         ItemSale[]
  createdById   String
  createdBy     User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([type])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([brand])
  @@index([name])
  @@unique([tenantId, code])
}

model ItemSale {
  id            String   @id @default(uuid())
  tenantId      String   @default("default-tenant")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          ItemType
  name          String
  brand         String
  code          String
  originalPrice Float
  customerPrice Float
  profit        Float
  quantitySold  Int      @default(1)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([itemId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([type])
  @@index([brand])
  @@index([code])
  @@index([createdAt])
}
