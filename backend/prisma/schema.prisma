generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

enum AccountType {
  ADMIN
  DOKAN
  DOKHT
  QICHIKAR
  FINANCE
}

enum TransactionKind {
  LOAN
}

enum TransactionSource {
  MANUAL
  SYSTEM_ORDER_ASSIGNMENT
  SYSTEM_WORKER_COMPLETION
  DAMAGE_PENALTY
}

enum WorkerPaymentStatus {
  UNPAID
  PAID_TO_WORKER
}

enum WorkerRoleType {
  QICHIKAR
  DOKHT
  WORKER
}

enum DraftStatus {
  DRAFT
}

model User {
  id           String      @id @default(uuid())
  name         String
  phoneNumber  String      @unique
  accountType  AccountType
  password     String
  isActive     Boolean     @default(true)
  refreshToken String?

  assignedOrders                 Order[]                 @relation("AssignedOrders")
  assignedByOrders               Order[]                 @relation("AssignedByOrders")
  receivedOrders                 Order[]                 @relation("ReceivedOrders")
  qichikarAssignedOrders         Order[]                 @relation("QichikarAssignedOrders")
  dokhtAssignedOrders            Order[]                 @relation("DokhtAssignedOrders")
  qichikarReceivedOrders         Order[]                 @relation("QichikarReceivedOrders")
  dokhtReceivedOrders            Order[]                 @relation("DokhtReceivedOrders")
  workerPaidOrders               Order[]                 @relation("WorkerPaidByOrders")
  qichikarPaidOrders             Order[]                 @relation("QichikarPaidByOrders")
  dokhtPaidOrders                Order[]                 @relation("DokhtPaidByOrders")
  workerPaymentReceipts          WorkerPaymentReceipt[]  @relation("WorkerPaymentReceiptWorker")
  createdWorkerPaymentReceipts   WorkerPaymentReceipt[]  @relation("WorkerPaymentReceiptAdmin")
  notifications                  UserNotification[]
  transactions                   Transaction[]           @relation("UserTransactions")
  createdTransactions            Transaction[]           @relation("CreatedTransactions")
  damagedClothesPenalties        DamagedClothesPenalty[] @relation("DamagedPenaltyUser")
  createdDamagedClothesPenalties DamagedClothesPenalty[] @relation("DamagedPenaltyCreator")
  createdDailyTasks              DailyTask[]             @relation("CreatedDailyTasks")
  orderDrafts                    OrderDraft[]
  rakhtPaymentHistories          RakhtPaymentHistory[]
  financeCreatedOrders           Order[]                 @relation("FinanceCreatedOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([accountType])
}

model UserNotification {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String?
  message String
  type    String  @default("ASSIGNMENT")
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(uuid())
  firstName   String
  phoneNumber String   @unique
  billNumber  Int      @unique
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
}

model Order {
  id                         String    @id @default(uuid())
  customerId                 String
  orderName                  String?
  type                       OrderType
  rakhtId                    String?
  rakhtTonId                 String?
  rakhtCompanyName           String?
  rakhtBrandName             String?
  rakhtColor                 String?
  rakhtColorHex              String?
  rakhtDate                  DateTime?
  rakhtRequiredMeters        Float?
  rakhtPiecePrice            Float?
  rakhtCustomerPricePerMeter Float?
  rakhtTotalCustomerPrice    Float?
  totalPrice                 Float
  totalBenefit               Float     @default(0)
  discount                   Float     @default(0)
  paidAmount                 Float
  remaining                  Float
  quantity                   Int       @default(1)
  isEmergency                Boolean   @default(false)
  emergencyExpiry            DateTime?
  isForeignOrder             Boolean   @default(false)
  isCompleted                Boolean   @default(false)
  inProgress                 Boolean   @default(false)

  // Entry month/year — set by admin at order creation time
  entryMonth Int?
  entryYear  Int?

  // Finance user who created this order (null for orders created by ADMIN/DOKAN)
  createdByFinanceId String?

  // Assignment fields
  assignedToId String?

  assignedById    String?
  assignedAt      DateTime?
  assignmentNote  String?
  assignmentPrice Float?
  receivedById    String?
  receivedAt      DateTime?

  // Role-based assignment & claim tracking
  qichikarAssignedToId String?
  qichikarAssignedAt   DateTime?
  qichikarReceivedById String?
  qichikarReceivedAt   DateTime?
  qichikarInProgress   Boolean   @default(false)

  dokhtAssignedToId String?
  dokhtAssignedAt   DateTime?
  dokhtReceivedById String?
  dokhtReceivedAt   DateTime?
  dokhtInProgress   Boolean   @default(false)

  // Workflow tracking for Qichikar -> Dokht flow
  // When Qichikar completes their task, we mark qichikarCompletedAt (not full completion)
  qichikarCompletedAt DateTime?
  // When Dokht completes, order becomes fully completed
  dokhtCompletedAt    DateTime?

  workerPaymentStatus WorkerPaymentStatus @default(UNPAID)
  workerPaymentAmount Float?
  workerPaidAt        DateTime?
  workerPaidById      String?

  // Role-specific worker payments (kept separate for Qichikar and Dokht)
  qichikarPaymentStatus WorkerPaymentStatus @default(UNPAID)
  qichikarPaymentAmount Float?
  qichikarPaidAt        DateTime?
  qichikarPaidById      String?

  dokhtPaymentStatus WorkerPaymentStatus @default(UNPAID)
  dokhtPaymentAmount Float?
  dokhtPaidAt        DateTime?
  dokhtPaidById      String?

  assignedTo         User? @relation("AssignedOrders", fields: [assignedToId], references: [id])
  assignedBy         User? @relation("AssignedByOrders", fields: [assignedById], references: [id])
  receivedBy         User? @relation("ReceivedOrders", fields: [receivedById], references: [id])
  qichikarAssignedTo User? @relation("QichikarAssignedOrders", fields: [qichikarAssignedToId], references: [id])
  dokhtAssignedTo    User? @relation("DokhtAssignedOrders", fields: [dokhtAssignedToId], references: [id])
  qichikarReceivedBy User? @relation("QichikarReceivedOrders", fields: [qichikarReceivedById], references: [id])
  dokhtReceivedBy    User? @relation("DokhtReceivedOrders", fields: [dokhtReceivedById], references: [id])
  workerPaidBy       User? @relation("WorkerPaidByOrders", fields: [workerPaidById], references: [id])
  qichikarPaidBy     User? @relation("QichikarPaidByOrders", fields: [qichikarPaidById], references: [id])
  dokhtPaidBy        User? @relation("DokhtPaidByOrders", fields: [dokhtPaidById], references: [id])
  createdByFinance   User? @relation("FinanceCreatedOrders", fields: [createdByFinanceId], references: [id])

  customer                Customer                @relation(fields: [customerId], references: [id])
  rakht                   Rakht?                  @relation(fields: [rakhtId], references: [id], onDelete: SetNull)
  rakhtTon                RakhtTon?               @relation(fields: [rakhtTonId], references: [id], onDelete: SetNull)
  boxId                   Int?
  box                     Box?                    @relation("OrderToBox", fields: [boxId], references: [id])
  foreignBoxId            Int?
  foreignBox              Box?                    @relation("ForeignOrderToBox", fields: [foreignBoxId], references: [id])
  outfit                  Outfit?
  waskat                  Waskat?
  korty                   Korty?
  yakhanQaq               YakhanQaq?
  readyMadeOrder          ReadyMadeOrder?
  notifications           Notification[]
  transactions            Transaction[]
  workerPaymentReceipts   WorkerPaymentReceipt[]
  damagedClothesPenalties DamagedClothesPenalty[]
  dailyTasks              DailyTask[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Ready-Made Clothes link
  readyMadeClothingId    String?
  readyMadeClothingCode  String?
  readyMadeOriginalPrice Float?
  readyMadeClothing      ReadyMadeClothing? @relation(fields: [readyMadeClothingId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([type])
  @@index([rakhtId])
  @@index([rakhtTonId])
  @@index([isCompleted])
  @@index([isEmergency])
  @@index([isForeignOrder])
  @@index([assignedToId])
  @@index([receivedById])
  @@index([qichikarAssignedToId])
  @@index([dokhtAssignedToId])
  @@index([qichikarReceivedById])
  @@index([dokhtReceivedById])
  @@index([workerPaymentStatus])
  @@index([workerPaidById])
  @@index([qichikarPaymentStatus])
  @@index([qichikarPaidById])
  @@index([dokhtPaymentStatus])
  @@index([dokhtPaidById])
  @@index([qichikarCompletedAt])
  @@index([dokhtCompletedAt])
  @@index([entryMonth])
  @@index([entryYear])
  @@index([createdByFinanceId])
}

model WorkerPaymentReceipt {
  id                String         @id @default(uuid())
  orderId           String
  workerId          String
  workerRole        WorkerRoleType
  paidAmount        Float
  receiptDate       DateTime       @default(now())
  receivedByAdminId String
  status            String         @default("RECEIVED")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker          User  @relation("WorkerPaymentReceiptWorker", fields: [workerId], references: [id], onDelete: Restrict)
  receivedByAdmin User  @relation("WorkerPaymentReceiptAdmin", fields: [receivedByAdminId], references: [id], onDelete: Restrict)

  @@unique([orderId, workerRole])
  @@index([orderId])
  @@index([workerId])
  @@index([workerRole])
  @@index([receiptDate])
  @@index([receivedByAdminId])
}

model OrderDraft {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientKey    String
  customerName String?
  orderTypes   String[]    @default([])
  step         Int         @default(0)
  status       DraftStatus @default(DRAFT)
  draftData    Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, status])
  @@index([updatedAt])
}

model Rakht {
  id             String     @id @default(uuid())
  companyName    String
  brandName      String
  tonQuantity    Int
  totalPrice     Float
  givenMoney     Float      @default(0)
  remainingMoney Float      @default(0)
  date           DateTime   @default(now())
  tons           RakhtTon[]
  orders         Order[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyName])
  @@index([brandName])
}

model RakhtPaymentHistory {
  id               String   @id @default(uuid())
  companyName      String
  paidAmount       Float
  totalPriceBefore Float
  totalPaidBefore  Float
  remainingBefore  Float
  totalPriceAfter  Float
  totalPaidAfter   Float
  remainingAfter   Float
  paidAt           DateTime @default(now())
  paidById         String
  paidBy           User     @relation(fields: [paidById], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([companyName])
  @@index([paidAt])
  @@index([paidById])
}

model RakhtTon {
  id          String   @id @default(uuid())
  rakhtId     String
  rakht       Rakht    @relation(fields: [rakhtId], references: [id], onDelete: Cascade)
  name        String
  colorHex    String
  totalMeters Float
  usedMeters  Float    @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rakhtId])
}

enum OrderType {
  OUTFIT
  WASKAT
  KORTY
  YAKHANQAQ
  READY_MADE
}

enum BoxType {
  OUTFIT
  WASKAT
  KORTY
  YAKHANQAQ
  FOREIGN_COUNTRY
}

model Outfit {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float
  shoulder Float
  sleeve   Float
  neck     Float
  chest    Float
  armpit   Float
  waist    Float
  skirt    Float
  tenban   Float
  pantLeg  Float
  arm      Float
  calf     Float

  neckStyle           String?
  sleeveStyle         String?
  sleeveSize          String?
  skirtStyle          String?
  frontPocket         Boolean @default(false)
  sidePocket          Boolean @default(false)
  underPocket         Boolean @default(false)
  outfitDesign        String?
  outfitStyle         String?
  buttonStyle         String?
  pantStyle           String?
  additionalStyleInfo String?
}

model Waskat {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float
  shoulder Float
  neck     Float
  chest    Float
  waist    Float
  sorain   Float

  neckStyle     String?
  shoulderState String?
  waskatStyle   String?
}

model Korty {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height           Float
  arm              Float
  shoulder         Float
  neck             Float
  sleeve           Float
  patlonHeight     Float
  kamerPatlon      Float
  doroBaghlePatlon Float
  waist            Float
  sorainPatlon     Float
  sorain           Float
  patPatlon        Float
  pachaPatlon      Float

  style String?
}

model YakhanQaq {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float
  sleeve   Float
  shoulder Float
  neck     Float
  armpit   Float
  sorain   Float
  chest    Float

  neckStyle       String?
  sleeveStyle     String?
  sleeveSize      String?
  skirtStyle      String?
  frontPocket     Boolean @default(false)
  yakhanQaqDesign String?
  buttonStyle     String?
  pantStyle       String?
}

// ─── Ready-Made Clothes ───────────────────────────────────────────────────────

model ReadyMadeClothing {
  id            String   @id @default(uuid())
  clothingCode  String   @unique
  originalPrice Float
  quantity      Int      @default(1)
  description   String?
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clothingCode])
}

model ReadyMadeOrder {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float?
  chest    Float?
  waist    Float?
  shoulder Float?
  sleeve   Float?
  neck     Float?
  armpit   Float?
  skirt    Float?
  tenban   Float?
  pantLeg  Float?
  arm      Float?
  calf     Float?
  sorain   Float?

  additionalNotes String?
}

model Notification {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean   @default(false)
  nextAlert DateTime
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orderId])
  @@index([isRead])
}

model Box {
  id            Int      @id @default(autoincrement())
  boxName       String
  boxType       BoxType
  capacity      Int
  orders        Order[]  @relation("OrderToBox")
  foreignOrders Order[]  @relation("ForeignOrderToBox")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Yakhan {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Astin {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShoulderState {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NeckOutfit {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NeckWaskat {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Daman {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JibRow {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JibBaghle {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JibTenban {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatyShip {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ButtonShip {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenbanShip {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutfitDesign {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YakhanQaqNeck {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YakhanQaqSleeve {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YakhanQaqSkirt {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YakhanQaqDesignOption {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YakhanQaqButtonShip {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YakhanQaqPantShip {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contributor {
  id           String   @id @default(uuid())
  name         String
  fatherName   String
  phoneNumber  String
  percentage   Float
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([phoneNumber])
}

// ─── Daily Tasks ─────────────────────────────────────────────────────────────

model DailyTask {
  id            String   @id @default(uuid())
  fromName      String
  recipientName String
  amount        Float
  taskDate      DateTime
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note          String?
  createdById   String
  createdBy     User     @relation("CreatedDailyTasks", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
  @@index([taskDate])
  @@index([orderId])
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id                    String                 @id @default(uuid())
  accountType           AccountType
  userId                String
  user                  User                   @relation("UserTransactions", fields: [userId], references: [id])
  orderId               String?
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                  TransactionKind        @default(LOAN)
  source                TransactionSource      @default(MANUAL)
  amount                Float
  transactionDate       DateTime
  note                  String?
  createdById           String
  createdBy             User                   @relation("CreatedTransactions", fields: [createdById], references: [id])
  damagedClothesPenalty DamagedClothesPenalty?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([accountType])
  @@index([kind])
  @@index([source])
  @@index([createdById])
  @@index([userId, source, kind])
}

model DamagedClothesPenalty {
  id                 String      @id @default(uuid())
  transactionId      String      @unique
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation("DamagedPenaltyUser", fields: [userId], references: [id], onDelete: Restrict)
  orderId            String
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roleType           AccountType
  reason             String
  confirmedDuplicate Boolean     @default(false)

  billNumber   Int
  customerName String
  orderType    OrderType

  totalOrderAmount Float
  rakhtExpense     Float
  dokhtExpense     Float
  qichikarExpense  Float
  dailyTaskExpense Float
  totalExpense     Float

  createdById String
  createdBy   User     @relation("DamagedPenaltyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([createdById])
  @@index([roleType])
  @@index([createdAt])
}
