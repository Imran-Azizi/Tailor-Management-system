generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

enum AccountType {
  SUPER_ADMIN
  ADMIN
  DOKAN
  DOKHT
  QICHIKAR
  FINANCE
}

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

model Tenant {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  slug               String             @unique
  businessName       String
  systemName         String
  address            String?
  phone              String?
  mobile             String?
  email              String?
  logoUrl            String?
  currency           String             @default("AFN")
  language           String             @default("fa")
  timezone           String             @default("Asia/Kabul")
  subscriptionPlan   SubscriptionPlan   @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionStart  DateTime?
  expiryDate         DateTime?
  isActive           Boolean            @default(true)

  users                    User[]
  customers                Customer[]
  orders                   Order[]
  outfits                  Outfit[]
  waskats                  Waskat[]
  korties                  Korty[]
  yakhanQaqs               YakhanQaq[]
  readyMadeOrders          ReadyMadeOrder[]
  readyMadeWaskatOrders    ReadyMadeWaskatOrder[]
  workerPaymentReceipts    WorkerPaymentReceipt[]
  orderDrafts              OrderDraft[]
  rakhts                   Rakht[]
  rakhtPaymentHistories    RakhtPaymentHistory[]
  rakhtTons                RakhtTon[]
  notifications            Notification[]
  userNotifications        UserNotification[]
  boxes                    Box[]
  yakhans                  Yakhan[]
  astins                   Astin[]
  shoulderStates           ShoulderState[]
  neckOutfits              NeckOutfit[]
  neckWaskats              NeckWaskat[]
  damans                   Daman[]
  jibRows                  JibRow[]
  jibBaghles               JibBaghle[]
  jibTenbans               JibTenban[]
  patyShips                PatyShip[]
  buttonShips              ButtonShip[]
  tenbanShips              TenbanShip[]
  outfitDesigns            OutfitDesign[]
  yakhanQaqNecks           YakhanQaqNeck[]
  yakhanQaqSleeves         YakhanQaqSleeve[]
  yakhanQaqSkirts          YakhanQaqSkirt[]
  yakhanQaqDesignOptions   YakhanQaqDesignOption[]
  yakhanQaqButtonShips     YakhanQaqButtonShip[]
  yakhanQaqPantShips       YakhanQaqPantShip[]
  readyMadeClothes         ReadyMadeClothing[]
  readyMadeWaskatClothes   ReadyMadeWaskatClothing[]
  dailyTasks               DailyTask[]
  transactions             Transaction[]
  damagedClothesPenalties  DamagedClothesPenalty[]
  items                    Item[]
  itemSales                ItemSale[]
  contributors             Contributor[]
  auditLogs                AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([subscriptionStatus])
  @@index([expiryDate])
  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([entity, entityId])
}

model BackupRecord {
  id              String   @id @default(uuid())
  backupId        String   @unique
  type            String
  scopeType       String
  scopeId         String?
  scopeName       String
  fileName        String
  storageKey      String
  sizeBytes       Int      @default(0)
  checksum        String?
  status          String   @default("SUCCESS")
  localSaveStatus String   @default("SUCCESS")
  emailSentStatus String   @default("PENDING")
  encrypted       Boolean  @default(false)
  compressed      Boolean  @default(true)
  createdById     String?
  createdByName   String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([backupId])
  @@index([type])
  @@index([scopeType, scopeId])
  @@index([status])
  @@index([createdAt])
}

model BackupSchedule {
  id                 String   @id @default("default")
  enabled            Boolean  @default(false)
  frequency          String   @default("DAILY")
  customCron         String?
  backupTime         String   @default("02:00")
  retentionDays      Int      @default(35)
  compressionEnabled Boolean  @default(true)
  encryptionEnabled  Boolean  @default(false)
  deleteOldAfterDays Int      @default(35)
  totalStorageBytes  Int      @default(1073741824)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum TransactionKind {
  LOAN
}

enum TransactionSource {
  MANUAL
  SYSTEM_ORDER_ASSIGNMENT
  SYSTEM_WORKER_COMPLETION
  DAMAGE_PENALTY
}

enum WorkerPaymentStatus {
  UNPAID
  PAID_TO_WORKER
}

enum WorkerRoleType {
  QICHIKAR
  DOKHT
  WORKER
}

enum DraftStatus {
  DRAFT
  WAITING_FOR_BOX
}

model User {
  id           String      @id @default(uuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phoneNumber  String
  accountType  AccountType
  password     String
  latestPassword String?
  isActive     Boolean     @default(true)
  refreshToken String?

  assignedOrders                 Order[]                 @relation("AssignedOrders")
  assignedByOrders               Order[]                 @relation("AssignedByOrders")
  receivedOrders                 Order[]                 @relation("ReceivedOrders")
  qichikarAssignedOrders         Order[]                 @relation("QichikarAssignedOrders")
  dokhtAssignedOrders            Order[]                 @relation("DokhtAssignedOrders")
  qichikarReceivedOrders         Order[]                 @relation("QichikarReceivedOrders")
  dokhtReceivedOrders            Order[]                 @relation("DokhtReceivedOrders")
  workerPaidOrders               Order[]                 @relation("WorkerPaidByOrders")
  qichikarPaidOrders             Order[]                 @relation("QichikarPaidByOrders")
  dokhtPaidOrders                Order[]                 @relation("DokhtPaidByOrders")
  workerPaymentReceipts          WorkerPaymentReceipt[]  @relation("WorkerPaymentReceiptWorker")
  createdWorkerPaymentReceipts   WorkerPaymentReceipt[]  @relation("WorkerPaymentReceiptAdmin")
  notifications                  UserNotification[]
  transactions                   Transaction[]           @relation("UserTransactions")
  createdTransactions            Transaction[]           @relation("CreatedTransactions")
  damagedClothesPenalties        DamagedClothesPenalty[] @relation("DamagedPenaltyUser")
  createdDamagedClothesPenalties DamagedClothesPenalty[] @relation("DamagedPenaltyCreator")
  createdDailyTasks              DailyTask[]             @relation("CreatedDailyTasks")
  orderDrafts                    OrderDraft[]
  rakhtPaymentHistories          RakhtPaymentHistory[]
  createdOrders                  Order[]                 @relation("CreatedOrders")
  financeCreatedOrders           Order[]                 @relation("FinanceCreatedOrders")
  createdItems                   Item[]
  createdItemSales               ItemSale[]
  auditLogs                      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([accountType])
  @@index([tenantId])
  @@index([tenantId, accountType])
  @@unique([tenantId, phoneNumber])
}

model UserNotification {
  id      String  @id @default(uuid())
  tenantId String  @default("default-tenant")
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String?
  message String
  type    String  @default("ASSIGNMENT")
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([tenantId, userId, isRead, createdAt])
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @default("default-tenant")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName   String
  phoneNumber String
  billNumber  Int
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
  @@index([tenantId])
  @@unique([tenantId, billNumber])
}

model Order {
  id                         String    @id @default(uuid())
  tenantId                   String    @default("default-tenant")
  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                 String
  billNumber                 Int?
  orderName                  String?
  type                       OrderType
  rakhtId                    String?
  rakhtTonId                 String?
  rakhtCompanyName           String?
  rakhtBrandName             String?
  rakhtColor                 String?
  rakhtColorHex              String?
  rakhtDate                  DateTime?
  rakhtRequiredMeters        Float?
  rakhtPiecePrice            Float?
  rakhtCustomerPricePerMeter Float?
  rakhtTotalCustomerPrice    Float?
  totalPrice                 Float
  totalBenefit               Float     @default(0)
  discount                   Float     @default(0)
  paidAmount                 Float
  remaining                  Float
  quantity                   Int       @default(1)
  isEmergency                Boolean   @default(false)
  emergencyExpiry            DateTime?
  isForeignOrder             Boolean   @default(false)
  isCompleted                Boolean   @default(false)
  completedAt                DateTime?
  netProfitRecognizedAt      DateTime?
  netProfitRecognizedAmount  Float?
  netProfitRecognizedById    String?
  inProgress                 Boolean   @default(false)

  entryMonth Int?
  entryYear  Int?

  createdByFinanceId String?
  createdById        String?
  createdByName      String?
  createdByRole      AccountType?
  assignedToId       String?
  assignedById       String?
  assignedAt         DateTime?
  assignmentNote     String?

  assignmentPrice Float?
  receivedById    String?
  receivedAt      DateTime?

  // Role-based assignment & claim tracking
  qichikarAssignedToId String?
  qichikarAssignedAt   DateTime?
  qichikarReceivedById String?
  qichikarReceivedAt   DateTime?
  qichikarInProgress   Boolean   @default(false)

  dokhtAssignedToId String?
  dokhtAssignedAt   DateTime?
  dokhtReceivedById String?
  dokhtReceivedAt   DateTime?
  dokhtInProgress   Boolean   @default(false)

  // Workflow tracking for Qichikar -> Dokht flow
  // When Qichikar completes their task, we mark qichikarCompletedAt (not full completion)
  qichikarCompletedAt DateTime?
  // When Dokht completes, order becomes fully completed
  dokhtCompletedAt    DateTime?

  workerPaymentStatus WorkerPaymentStatus @default(UNPAID)
  workerPaymentAmount Float?
  workerPaidAt        DateTime?
  workerPaidById      String?

  // Role-specific worker payments (kept separate for Qichikar and Dokht)
  qichikarPaymentStatus WorkerPaymentStatus @default(UNPAID)
  qichikarPaymentAmount Float?
  qichikarPaidAt        DateTime?
  qichikarPaidById      String?

  dokhtPaymentStatus WorkerPaymentStatus @default(UNPAID)
  dokhtPaymentAmount Float?
  dokhtPaidAt        DateTime?
  dokhtPaidById      String?

  assignedTo         User? @relation("AssignedOrders", fields: [assignedToId], references: [id])
  assignedBy         User? @relation("AssignedByOrders", fields: [assignedById], references: [id])
  receivedBy         User? @relation("ReceivedOrders", fields: [receivedById], references: [id])
  qichikarAssignedTo User? @relation("QichikarAssignedOrders", fields: [qichikarAssignedToId], references: [id])
  dokhtAssignedTo    User? @relation("DokhtAssignedOrders", fields: [dokhtAssignedToId], references: [id])
  qichikarReceivedBy User? @relation("QichikarReceivedOrders", fields: [qichikarReceivedById], references: [id])
  dokhtReceivedBy    User? @relation("DokhtReceivedOrders", fields: [dokhtReceivedById], references: [id])
  workerPaidBy       User? @relation("WorkerPaidByOrders", fields: [workerPaidById], references: [id])
  qichikarPaidBy     User? @relation("QichikarPaidByOrders", fields: [qichikarPaidById], references: [id])
  dokhtPaidBy        User? @relation("DokhtPaidByOrders", fields: [dokhtPaidById], references: [id])
  createdBy          User? @relation("CreatedOrders", fields: [createdById], references: [id])
  createdByFinance   User? @relation("FinanceCreatedOrders", fields: [createdByFinanceId], references: [id])

  customer                Customer                @relation(fields: [customerId], references: [id])
  rakht                   Rakht?                  @relation(fields: [rakhtId], references: [id], onDelete: SetNull)
  rakhtTon                RakhtTon?               @relation(fields: [rakhtTonId], references: [id], onDelete: SetNull)
  boxId                   Int?
  box                     Box?                    @relation("OrderToBox", fields: [boxId], references: [id])
  foreignBoxId            Int?
  foreignBox              Box?                    @relation("ForeignOrderToBox", fields: [foreignBoxId], references: [id])
  outfit                  Outfit?
  waskat                  Waskat?
  korty                   Korty?
  yakhanQaq               YakhanQaq?
  readyMadeOrder          ReadyMadeOrder?
  readyMadeWaskatOrder    ReadyMadeWaskatOrder?
  notifications           Notification[]
  transactions            Transaction[]
  workerPaymentReceipts   WorkerPaymentReceipt[]
  damagedClothesPenalties DamagedClothesPenalty[]
  dailyTasks              DailyTask[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Ready-Made Clothes link
  readyMadeClothingId    String?
  readyMadeClothingCode  String?
  readyMadeOriginalPrice Float?
  readyMadeClothing      ReadyMadeClothing? @relation(fields: [readyMadeClothingId], references: [id], onDelete: SetNull)

  // Ready-Made Waskat link
  readyMadeWaskatClothingId    String?
  readyMadeWaskatClothingCode  String?
  readyMadeWaskatOriginalPrice Float?
  readyMadeWaskatClothing      ReadyMadeWaskatClothing? @relation(fields: [readyMadeWaskatClothingId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([billNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, billNumber])
  @@index([type])
  @@index([rakhtId])
  @@index([rakhtTonId])
  @@index([isCompleted])
  @@index([netProfitRecognizedAt])
  @@index([netProfitRecognizedById])
  @@index([isEmergency])
  @@index([isForeignOrder])
  @@index([assignedToId])
  @@index([receivedById])
  @@index([qichikarAssignedToId])
  @@index([dokhtAssignedToId])
  @@index([qichikarReceivedById])
  @@index([dokhtReceivedById])
  @@index([workerPaymentStatus])
  @@index([workerPaidById])
  @@index([qichikarPaymentStatus])
  @@index([qichikarPaidById])
  @@index([dokhtPaymentStatus])
  @@index([dokhtPaidById])
  @@index([qichikarCompletedAt])
  @@index([dokhtCompletedAt])
  @@index([entryMonth])
  @@index([entryYear])
  @@index([createdById])
  @@index([createdByFinanceId])
  @@index([createdAt])
  @@index([customerId, type, createdAt])
  @@index([entryYear, entryMonth])
  @@index([createdByFinanceId, entryYear, entryMonth])
  @@index([isCompleted, createdAt])
  @@index([isCompleted, completedAt])
  @@index([tenantId, netProfitRecognizedAt])
  @@index([tenantId, isCompleted, createdAt])
  @@index([tenantId, entryYear, entryMonth])
}

model WorkerPaymentReceipt {
  id                String         @id @default(uuid())
  tenantId          String         @default("default-tenant")
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId           String
  workerId          String
  workerRole        WorkerRoleType
  paidAmount        Float
  receiptDate       DateTime       @default(now())
  receivedByAdminId String
  status            String         @default("RECEIVED")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker          User  @relation("WorkerPaymentReceiptWorker", fields: [workerId], references: [id], onDelete: Restrict)
  receivedByAdmin User  @relation("WorkerPaymentReceiptAdmin", fields: [receivedByAdminId], references: [id], onDelete: Restrict)

  @@unique([orderId, workerRole])
  @@index([orderId])
  @@index([tenantId])
  @@index([tenantId, receiptDate])
  @@index([workerId])
  @@index([workerRole])
  @@index([receiptDate])
  @@index([receivedByAdminId])
}

model OrderDraft {
  id           String      @id @default(uuid())
  tenantId     String      @default("default-tenant")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientKey    String
  customerName String?
  orderTypes   String[]    @default([])
  step         Int         @default(0)
  status       DraftStatus @default(DRAFT)
  draftData    Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, clientKey])
  @@index([tenantId])
  @@index([userId, status])
  @@index([tenantId, userId, status])
  @@index([updatedAt])
}

model Rakht {
  id             String     @id @default(uuid())
  tenantId       String     @default("default-tenant")
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName    String
  brandName      String
  tonQuantity    Int
  totalPrice     Float
  givenMoney     Float      @default(0)
  remainingMoney Float      @default(0)
  date           DateTime   @default(now())
  tons           RakhtTon[]
  orders         Order[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyName])
  @@index([tenantId])
  @@index([tenantId, companyName])
  @@index([brandName])
  @@index([date])
}

model RakhtPaymentHistory {
  id               String   @id @default(uuid())
  tenantId         String   @default("default-tenant")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName      String
  paidAmount       Float
  totalPriceBefore Float
  totalPaidBefore  Float
  remainingBefore  Float
  totalPriceAfter  Float
  totalPaidAfter   Float
  remainingAfter   Float
  paidAt           DateTime @default(now())
  paidById         String
  paidBy           User     @relation(fields: [paidById], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([companyName])
  @@index([tenantId])
  @@index([tenantId, companyName])
  @@index([paidAt])
  @@index([paidById])
}

model RakhtTon {
  id          String   @id @default(uuid())
  tenantId    String   @default("default-tenant")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rakhtId     String
  rakht       Rakht    @relation(fields: [rakhtId], references: [id], onDelete: Cascade)
  name        String
  colorHex    String
  totalMeters Float
  usedMeters  Float    @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rakhtId])
  @@index([tenantId])
  @@index([tenantId, rakhtId])
}

enum OrderType {
  OUTFIT
  WASKAT
  KORTY
  YAKHANQAQ
  READY_MADE
  READY_MADE_WASKAT
}

enum BoxType {
  OUTFIT
  WASKAT
  KORTY
  YAKHANQAQ
  FOREIGN_COUNTRY
}

model Outfit {
  id       String @id @default(uuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float
  shoulder Float
  sleeve   Float
  neck     Float
  chest    Float
  armpit   Float
  waist    Float
  skirt    Float
  tenban   Float
  pantLeg  Float
  arm      Float
  calf     Float

  neckStyle           String?
  sleeveStyle         String?
  sleeveSize          String?
  skirtStyle          String?
  frontPocket         Boolean @default(false)
  sidePocket          Boolean @default(false)
  doubleSidePocket    Boolean @default(false)
  underPocket         Boolean @default(false)
  outfitDesign        String?
  outfitStyle         String?
  buttonStyle         String?
  pantStyle           String?
  additionalStyleInfo String?

  @@index([tenantId])
  @@index([tenantId, orderId])
}

model Waskat {
  id       String @id @default(uuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float
  shoulder Float
  neck     Float
  chest    Float
  waist    Float
  sorain   Float

  neckStyle     String?
  shoulderState String?
  waskatStyle   String?

  @@index([tenantId])
  @@index([tenantId, orderId])
}

model Korty {
  id       String @id @default(uuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height           Float
  arm              Float
  shoulder         Float
  neck             Float
  sleeve           Float
  patlonHeight     Float
  kamerPatlon      Float
  doroBaghlePatlon Float
  waist            Float
  sorainPatlon     Float
  sorain           Float
  patPatlon        Float
  pachaPatlon      Float

  style String?

  @@index([tenantId])
  @@index([tenantId, orderId])
}

model YakhanQaq {
  id       String @id @default(uuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float
  sleeve   Float
  shoulder Float
  neck     Float
  armpit   Float
  sorain   Float
  chest    Float

  neckStyle       String?
  sleeveStyle     String?
  sleeveSize      String?
  skirtStyle      String?
  frontPocket     Boolean @default(false)
  yakhanQaqDesign String?
  buttonStyle     String?
  pantStyle       String?

  @@index([tenantId])
  @@index([tenantId, orderId])
}

// ─── Ready-Made Clothes ───────────────────────────────────────────────────────

model ReadyMadeClothing {
  id            String   @id @default(uuid())
  tenantId      String   @default("default-tenant")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clothingCode  String
  originalPrice Float
  quantity      Int      @default(1)
  description   String?
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clothingCode])
  @@index([tenantId])
  @@unique([tenantId, clothingCode])
}

model ReadyMadeOrder {
  id       String @id @default(uuid())
  tenantId String @default("default-tenant")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  height   Float?
  chest    Float?
  waist    Float?
  shoulder Float?
  sleeve   Float?
  neck     Float?
  armpit   Float?
  skirt    Float?
  tenban   Float?
  pantLeg  Float?
  arm      Float?
  calf     Float?
  sorain   Float?

  neckStyle           String?
  sleeveStyle         String?
  sleeveSize          String?
  skirtStyle          String?
  frontPocket         Boolean @default(false)
  sidePocket          Boolean @default(false)
  doubleSidePocket    Boolean @default(false)
  underPocket         Boolean @default(false)
  outfitDesign        String?
  outfitStyle         String?
  buttonStyle         String?
  pantStyle           String?
  additionalStyleInfo String?
  additionalNotes     String?

  @@index([tenantId])
  @@index([tenantId, orderId])
}

model ReadyMadeWaskatClothing {
  id            String   @id @default(uuid())
  tenantId      String   @default("default-tenant")
