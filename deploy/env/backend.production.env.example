# Copy to backend/.env on your VPS:
#   cp deploy/env/backend.production.env.example backend/.env
# Then edit secrets and database URL.

NODE_ENV=production
PORT=8000
TRUST_PROXY=1

# Public site URL (bare domain expands to http/https + www in CORS)
APP_PUBLIC_URL=http://hoshmandsafi.com
FRONTEND_URL=http://hoshmandsafi.com

# Cookies — use false on HTTP; switch to true after enabling HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SERVE_FRONTEND=true

# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tailor_management_system"

# Strong random secrets (generate new values for production)
JWT_SECRET="change-me-long-random-string"
JWT_REFRESH_SECRET="change-me-long-random-refresh-string"
CSRF_SECRET="change-me-long-random-csrf-string"

# Optional backup settings
BACKUP_ENABLED=false
