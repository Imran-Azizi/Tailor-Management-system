# Copy to backend/.env on your VPS:
#   cp deploy/env/backend.production.env.example backend/.env
# Then edit secrets and database URL.

NODE_ENV=production
PORT=8000
TRUST_PROXY=1

# Public site URL (include apex + admin origins for CORS)
APP_PUBLIC_URL=https://hoshmandsafi.com
FRONTEND_URL=https://admin.hoshmandsafi.com
APP_ROOT_DOMAIN=hoshmandsafi.com
ADMIN_SUBDOMAIN=admin

# Cookies — required for seamless login across apex/admin/tenant subdomains
# Use COOKIE_SECURE=true when HTTPS is enabled (recommended for production)
COOKIE_DOMAIN=.hoshmandsafi.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SERVE_FRONTEND=true

# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tailor_management_system?connection_limit=10"

# Strong random secrets (generate new values for production)
JWT_SECRET="change-me-long-random-string"
JWT_REFRESH_SECRET="change-me-long-random-refresh-string"
CSRF_SECRET="change-me-long-random-csrf-string"

# Optional backup settings
BACKUP_ENABLED=false
