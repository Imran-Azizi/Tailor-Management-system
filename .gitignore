# Root-level ignores for the entire tailor-system repository

# Node.js dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output and bundler caches
/dist/
/build/
/out/
/.turbo/
/.vercel/
/.cache/
/.next/
/frontend/dist/
/frontend/.vite/

# Environment variables and secrets
.env
.env.*
*.env
!.env.example

# Local config and editor settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
Icon?

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# TypeScript cache files
*.tsbuildinfo

# Misc runtime files
*.pid
*.seed

# Project-specific runtime/storage folders
/backend/tmp/uploads/
/backend/tmp/tenant-logos/
/backend/storage/backup/
/backend/storage/secure-backups/
/backend/storage/.cache/

# Generated frontend artifacts
/frontend/dist/
/frontend/.vite/
/frontend/.cache/

# Ignore application runtime cache or local data if any
*.local

# Ignore lockfiles created for local development tooling (optional)
# Uncomment if you want to ignore Yarn/NPM lockfiles in local branches
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
