# =============================================================================
# Hoshmand Safi Tailor System — Monorepo .gitignore
# Covers: frontend (Vite/React), backend (Express/Prisma), docs, scripts
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js

# -----------------------------------------------------------------------------
# Build & production output
# -----------------------------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.output/
storybook-static/
*.tsbuildinfo

# Frontend (Vite)
frontend/dist/

# -----------------------------------------------------------------------------
# Environment variables & secrets
# Never commit real credentials — only .env.example templates belong in git.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.*.example

frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example

# OAuth & cloud credentials (Google Drive backup, S3 keys, service accounts)
**/tailor-oauth-token.json
**/tailor-oauth-settings.json
*credentials*.json
*service-account*.json
*.p12
*.pfx

# TLS / SSH keys
*.pem
*.key
*.cert
*.crt
*.csr
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# -----------------------------------------------------------------------------
# Runtime uploads, storage & temporary files (backend)
# -----------------------------------------------------------------------------
backend/uploads/
!backend/uploads/.gitkeep
!backend/uploads/**/.gitkeep

backend/storage/
!backend/storage/.gitkeep
!backend/storage/**/.gitkeep

backend/tmp/
!backend/tmp/.gitkeep
!backend/tmp/**/.gitkeep

# Backup archives & restore working copies
**/secure-backups/
**/*.sql.gz
**/*.dump
**/*.backup

# Downloaded report fonts (fetched by ensureReportFonts.js on deploy)
backend/src/fonts/*.ttf
backend/src/fonts/*.otf
backend/src/fonts/*.woff
backend/src/fonts/*.woff2
!backend/src/fonts/README.md

# -----------------------------------------------------------------------------
# Database (local/dev only — migrations stay tracked)
# -----------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
backend/prisma/dev.db

# -----------------------------------------------------------------------------
# Logs & debug output
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# Test & coverage artifacts
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/
playwright/.cache/

# -----------------------------------------------------------------------------
# Generated exports & downloaded report output (not React report UI components)
exports/
**/report-exports/
backend/reports/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Dari user manual build output (source docx in docs/ is kept)
docs/generated-dari-manual/docx-parts/

# -----------------------------------------------------------------------------
# Cache directories
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
node_modules/.cache/
.npm/

# Prisma local engine cache (generated client is rebuilt via `prisma generate`)
# Migrations and schema.prisma remain tracked.

# -----------------------------------------------------------------------------
# Package managers (keep lockfiles — do not ignore package-lock.json / yarn.lock)
# -----------------------------------------------------------------------------
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Editors & IDEs (personal/local settings only — shared config may stay tracked)
# -----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.history/
*.sublime-project
*.sublime-workspace

# VS Code / Cursor — ignore local overrides, keep shared workspace settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Cursor local state (keep rules/skills if you add them to the repo later)
.cursor/*
!.cursor/rules/
!.cursor/skills/

# -----------------------------------------------------------------------------
# Deployment & CI (platform config files are tracked; local deploy secrets are not)
# -----------------------------------------------------------------------------
.vercel
.netlify
.railway/
*.local

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
*.orig
*.rej
*.pid
*.seed
*.pid.lock
.tern-port
.vscode-test/
